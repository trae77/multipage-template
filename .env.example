# Copy to .env for local use (server reads process.env; use `node --env-file=.env server/index.js`).
PORT=3000
DATA_DIR=./data                 # SQLite file + uploads. On Render: /var/data (the disk)
OWNER_EMAIL=owner@example.com   # owner login is created/updated from these on every start
OWNER_PASSWORD=change-me-please
SEED_DEMO_DATA=false            # true = add sample customer + sample gallery/blog content

# Notifications: OFF unless the provider vars are set.
NOTIFY_FROM=
NOTIFY_OWNER_EMAIL=
NOTIFY_OWNER_PHONE=
RESEND_API_KEY=                 # email via Resend, or:
SMTP_URL=                       # smtp://user:pass@host:587  (also run: npm i nodemailer)
TWILIO_ACCOUNT_SID=             # text messages via Twilio
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
